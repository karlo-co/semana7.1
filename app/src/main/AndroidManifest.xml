<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!-- ========================================= -->
    <!-- PERMISOS -->
    <!-- ========================================= -->

    <!-- Permiso para obtener ubicación aproximada -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Permiso para obtener ubicación precisa -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Permiso para utilizar cámara / flash -->
    <uses-permission
        android:name="android.permission.CAMERA" />

    <!-- NOTA: ACTION_DIAL, ACTION_SENDTO, ACTION_VIEW y ACTION_GET_CONTENT -->
    <!-- NO necesitan permisos, porque es la otra app la que hace el trabajo. -->


    <!-- ========================================= -->
    <!-- HARDWARE -->
    <!-- ========================================= -->

    <!-- Indicamos que podemos utilizar el flash -->
    <!-- required=false permite instalar la app -->
    <!-- incluso si el dispositivo no tiene flash -->

    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />


    <!-- ========================================= -->
    <!-- QUERIES (VISIBILIDAD DE PAQUETES) -->
    <!-- ========================================= -->

    <!--
        Desde Android 11 (API 30) una app NO puede "ver" qué otras
        apps están instaladas. Por eso resolveActivity() devuelve null
        aunque exista Google Maps o un navegador.

        Aquí declaramos qué tipo de intents implícitos vamos a lanzar,
        para que resolveActivity() funcione y podamos VALIDAR
        si existe una app capaz de responder.
    -->

    <queries>

        <!-- Implícito 1: abrir mapas (geo:) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>

        <!-- Implícito 2: abrir página web (https://) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>

        <!-- Implícito 3: marcador telefónico (tel:) -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>

        <!-- Implícito 4: enviar correo (mailto:) -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>

        <!-- Implícito 5: seleccionar imagen de galería -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>

    </queries>


    <!-- ========================================= -->
    <!-- APLICACIÓN -->
    <!-- ========================================= -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Semana7">


        <!-- ===================================== -->
        <!-- EXPLÍCITO 1: DETALLE (recibe extras) -->
        <!-- ===================================== -->

        <activity
            android:name=".DetalleActivity"
            android:exported="false" />


        <!-- ===================================== -->
        <!-- EXPLÍCITO 2: AJUSTES (Toolbar + atrás) -->
        <!-- ===================================== -->

        <activity
            android:name=".ConfigActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />


        <!-- ===================================== -->
        <!-- EXPLÍCITO 3: FORMULARIO → CONFIRMACIÓN -->
        <!-- ===================================== -->

        <activity
            android:name=".FormActivity"
            android:exported="false" />

        <activity
            android:name=".ConfirmActivity"
            android:exported="false" />


        <!-- ===================================== -->
        <!-- PANTALLA PRINCIPAL -->
        <!-- ===================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>

                <!-- Indica que esta es la Activity principal -->
                <action
                    android:name="android.intent.action.MAIN" />

                <!-- Permite que aparezca en el menú del teléfono -->
                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


    </application>

</manifest>
